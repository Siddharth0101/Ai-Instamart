# Local pilot. Copy to .env.local. Never commit real keys.
# Canonical browser and OAuth origin; match the server's explicit --port.
# The development root page redirects the same-port localhost/127.0.0.1 alias here.
APP_ORIGIN=http://127.0.0.1:3000
# Required for live OAuth storage: 32 random bytes encoded as base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# ElevenLabs secret API key (not Copy Key ID), with STT and TTS access.
# Server-only: never use a NEXT_PUBLIC_ key.
ELEVENLABS_API_KEY=
# Optional voice/model overrides for spoken replies. Flash v2.5 is the low-latency Hindi + English default.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Optional speech-recognition language hints (ISO 639 codes). Secondary codes limit language detection.
# Unset means English with Hindi; an empty secondary list pins recognition to the primary language.
# ELEVENLABS_STT_LANGUAGE=en
# ELEVENLABS_STT_SECONDARY_LANGUAGES=hi
# The voice agent (Vercel AI SDK + Groq). Without it the assistant cannot act on speech.
GROQ_API_KEY=
# Optional: the agent model. openai/gpt-oss-20b takes over automatically when this one is rate limited.
# GROQ_AGENT_MODEL=openai/gpt-oss-120b
# Optional: longest wait for one spoken turn before a short fallback reply (milliseconds).
# SAYCART_AGENT_TIMEOUT_MS=25000
# Development only: synthetic Swiggy Food and Instamart stores, addresses and orders (never real ones). Ignored in production.
# SAYCART_FIXTURE=1
# Swiggy Food prices arrive in whole rupees (verified against live menus). Set to paise only if that changes.
# SWIGGY_FOOD_PRICE_UNIT=rupees
# Embedded PostgreSQL, one Node process only. Back up this private directory.
DATA_DIR=.local-data/postgres
