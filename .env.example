# Local pilot. Copy to .env.local. Never commit real keys.
# Canonical browser and OAuth origin; match the server's explicit --port.
# The development root page redirects the same-port localhost/127.0.0.1 alias here.
APP_ORIGIN=http://127.0.0.1:3000
# Required for live OAuth storage: 32 random bytes encoded as base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Enables inline live dictation. Server-only: never use a NEXT_PUBLIC_ key.
ELEVENLABS_API_KEY=
# Enables hosted structured shopping intent.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional spoken replies; set only after starting a private Kokoro service.
# Example: http://127.0.0.1:8880
KOKORO_URL=
KOKORO_VOICE=af_heart
KOKORO_MODEL=kokoro
# Embedded PostgreSQL, one Node process only. Back up this private directory.
DATA_DIR=.local-data/postgres
